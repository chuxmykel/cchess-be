{
  "name": "cchess-be",
  "version": "0.0.1",
  "description": "Real-time chess game server (NestJS): auth, profiles, friends, matchmaking, challenges, and rules-enforced live play.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "socket.io": "$socket.io"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typeorm": "typeorm",
    "migration:generate": "npm run build && node --env-file=.env node_modules/typeorm/cli.js migration:generate -d dist/database/data-source.js",
    "migration:run": "npm run build && node --env-file=.env node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build && node --env-file=.env node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "~12.1.2",
    "@nestjs/config": "~12.0.1",
    "@nestjs/core": "~12.1.2",
    "@nestjs/event-emitter": "~12.0.1",
    "@nestjs/jwt": "~12.0.2",
    "@nestjs/passport": "~12.0.0",
    "@nestjs/platform-express": "~12.1.2",
    "@nestjs/platform-socket.io": "~12.1.2",
    "@nestjs/swagger": "~12.0.2",
    "@nestjs/typeorm": "~12.0.2",
    "@nestjs/websockets": "~12.1.2",
    "@socket.io/redis-adapter": "~8.3.0",
    "bcrypt": "~6.0.0",
    "better-sqlite3": "~12.11.1",
    "chess.js": "~1.4.0",
    "class-transformer": "~0.5.1",
    "class-validator": "~0.15.1",
    "dotenv": "~18.0.3",
    "passport": "~0.7.0",
    "passport-jwt": "~4.0.1",
    "pg": "~8.23.1",
    "redis": "~6.3.0",
    "reflect-metadata": "~0.2.2",
    "rxjs": "~7.8.2",
    "socket.io": "~4.8.4",
    "typeorm": "~1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "~12.0.8",
    "@nestjs/schematics": "~12.0.6",
    "@nestjs/testing": "~12.1.2",
    "@types/bcrypt": "~6.0.0",
    "@types/express": "~5.0.6",
    "@types/node": "~24.19.1",
    "@types/passport-jwt": "~4.0.1",
    "@types/pg": "~8.23.1",
    "@types/supertest": "~7.2.1",
    "@vitest/coverage-v8": "~4.1.11",
    "oxlint": "~1.87.0",
    "oxlint-tsgolint": "~7.0.2003",
    "prettier": "~3.9.9",
    "socket.io-client": "~4.8.4",
    "source-map-support": "~0.5.21",
    "supertest": "~7.3.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11"
  }
}
