# Copy to .env and fill in for anything beyond local dev.
# None of these are required locally - sane (insecure) defaults are used
# automatically outside NODE_ENV=production; see src/config/configuration.ts.

PORT=3000
CORS_ORIGIN=*

# SQLite file path (swap the TypeORM config in app.module.ts for Postgres when ready)
DB_PATH=data/cchess.sqlite

# Required in production - any long random string
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_DAYS=30

# Grace period (ms) before a disconnected player forfeits by abandonment
GAME_DISCONNECT_GRACE_MS=60000
# Half-moves (plies) before abort is replaced by resign/draw
GAME_ABORT_PLY_LIMIT=2
