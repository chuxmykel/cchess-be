# Copy to .env and fill in - see src/config/configuration.ts. The Postgres
# connection and JWT secrets below have no built-in default (deliberately -
# a missing .env should fail loudly at boot, not silently connect to a
# guessed-at database or sign tokens with a secret baked into source
# control); everything else below them does have a sane default and can be
# left blank.

PORT=
CORS_ORIGIN=

# Postgres connection (see README for local setup - role + database creation)
# Required - no default.
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# Overrides the pool size outright instead of the cluster-aware default
# computed from CLUSTER_WORKERS (see app.module.ts) - e.g. when Postgres is
# on a separate host with its own max_connections headroom to spend.
DB_POOL_SIZE=
# The test suite's own Postgres connection - read directly out of this file
# by vitest.config.ts/vitest.config.e2e.ts (via vitest.env.ts), not by the
# app itself, and kept separate from the DB_* vars above so tests never
# share connection details with dev/prod (e.g. CI can point this at a
# different host entirely). All required, unlike the blanks above: leaving
# any of them unset fails the test run immediately at config-load time -
# for TEST_DB_NAME specifically, rather than silently falling back to
# DB_NAME and letting truncateAllTables (see CLAUDE.md) wipe that database
# instead.
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
TEST_DB_NAME=

# Required - no default. Any long random string.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_DAYS=

# Grace period (ms) before a disconnected player forfeits by abandonment
GAME_DISCONNECT_GRACE_MS=
# Half-moves (plies) before abort is replaced by resign/draw
GAME_ABORT_PLY_LIMIT=

# Multi-process sharding (see src/cluster/) - unset or 1 disables it (default).
# Only matters when > 1; Redis is only needed in that case too.
CLUSTER_WORKERS=
# REDIS_HOST/REDIS_PORT: required - no default - once CLUSTER_WORKERS > 1.
# REDIS_PASSWORD is genuinely optional: a password-less Redis is a normal
# setup, not a guessed-at value standing in for a real one.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
